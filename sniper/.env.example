# Skopiuj do sniper/.env i uzupełnij. Plik .env jest w .gitignore - nie commituj haseł!

# Rotacyjne proxy IPRoyal (oficjalny wzorzec: http://{proxy_auth}@{proxy})
SNIPER_PROXY_HOST=geo.iproyal.com:12321
SNIPER_PROXY_AUTH=LOGIN:HASLO_country-pl
# Alternatywnie zamiast dwóch powyższych - gotowy URL:
# SNIPER_PROXY_URL=http://LOGIN:HASLO_country-pl@geo.iproyal.com:12321
# Bez proxy Zwiadowca nie wystartuje (cały jego ruch idzie przez IPRoyal). false = świadome wyłączenie blokady.
SNIPER_REQUIRE_PROXY=true

# Konto Onet (SMTP SSL 465)
SNIPER_SMTP_HOST=smtp.poczta.onet.pl
SNIPER_SMTP_PORT=465
SNIPER_SMTP_USER=twoj_login@onet.pl
SNIPER_SMTP_PASSWORD=
# Adres, na który mają przychodzić alerty (domyślnie = SNIPER_SMTP_USER)
SNIPER_EMAIL_TO=

# Co skanujemy
# Katalog: numer kategorii z Vinted (np. 3580 = laptopy) - w URL przeglądarki: catalog[]=3580
SNIPER_CATALOG=3580
SNIPER_SEARCH_TEXT=
# Zakres ceny w PLN (puste = bez ograniczenia)
SNIPER_PRICE_FROM=100
SNIPER_PRICE_TO=
# Ofert na jeden skan: 20 = ~9 KB transferu, 96 = ~39 KB (zmierzone check_per_page.py)
SNIPER_PER_PAGE=20
# Pamięć ID przeciw duplikatom (minimum 5 x SNIPER_PER_PAGE, nie mniej niż 100)
SNIPER_DEDUP_SIZE=100

# Tempo
# Odstęp między startami skanów (s): 15 = 4 skany na minutę. Każdy skan to ~1 zapytanie przez proxy.
SNIPER_POLL_INTERVAL=15
# Losowe odchylenie +/- (s)
SNIPER_POLL_JITTER=1
# Co ile sekund linia "[SCOUT] Żyję: ..." w logu (0 = wyłączone)
SNIPER_HEARTBEAT=60
SNIPER_MAX_CONCURRENT_DETAILS=5

# Folder logów (domyślnie sniper/logs): sniper.log (nowy plik co północ, 30 dni) + offers.jsonl
# SNIPER_LOG_DIR=

# Odświeżanie sesji przez Playwright (każda próba przez rotacyjne proxy = nowe IP)
SNIPER_REFRESH_ATTEMPTS=6
# Sekundy między próbami
SNIPER_REFRESH_RETRY_DELAY=5
# Limit czasu jednej próby (s)
SNIPER_REFRESH_TIMEOUT=90
# Przerwa po serii nieudanych prób, zanim zacznie się kolejna seria (s)
SNIPER_REFRESH_BACKOFF=30

# Lekka przeglądarka przy odświeżaniu sesji (bez obrazków, wideo, fontów, reklam/analityki): true/false
SNIPER_BROWSER_LIGHT=true
# Używaj zapisanej sesji po restarcie, jeśli młodsza niż tyle minut (0 = zawsze nowa przez przeglądarkę)
SNIPER_SESSION_MAX_AGE=360

# ---------------------------------------------------------------------------
# Ocena ofert przez AI (sniper/evaluator.py, API Anthropic / Claude).
# Wywołania idą BEZPOŚREDNIO z komputera, nie przez proxy IPRoyal. Zdjęcia model pobiera sam z URL-i.
# Wyniki: sniper/logs/evaluations.csv (do Excela) + evaluations.jsonl (pełne dane).
# Test bez czekania na ogłoszenie: python -m sniper.evaluator --last 5
# ---------------------------------------------------------------------------
SNIPER_AI_ENABLED=true
# Klucz z https://platform.claude.com (Settings -> API keys). Można też ustawić ANTHROPIC_API_KEY.
SNIPER_AI_API_KEY=
SNIPER_AI_MODEL=claude-opus-5-5
# Głębokość myślenia: low (taniej, szybciej) / medium / high. Dla claude-haiku-4-5 zostaw puste.
SNIPER_AI_EFFORT=medium
# Gdy model odmówi odpowiedzi, API samo spróbuje modelu zapasowego. Dla claude-haiku-4-5 ustaw false.
SNIPER_AI_FALLBACK=true
SNIPER_AI_MAX_TOKENS=8000
# Ile zdjęć z ogłoszenia wysyłać (każde ~1-1,6 tys. tokenów wejścia)
SNIPER_AI_MAX_PHOTOS=6
# Plik z wytycznymi (domyślnie sniper/guidelines.md) - zmiany działają bez restartu
# SNIPER_AI_GUIDELINES=

# Mail tylko o ofertach z oceną >= progu (0-10). Nieocenione (błąd AI) przychodzą zawsze.
SNIPER_AI_MIN_SCORE=7
# true = mail o każdej ofercie (z oceną AI w treści), jak przed modułem AI
SNIPER_AI_NOTIFY_ALL=false

# Równoległe wywołania, limit czasu jednej próby (s), liczba ponowień i przerwa przed pierwszym ponowieniem (s)
SNIPER_AI_MAX_CONCURRENT=3
SNIPER_AI_TIMEOUT=120
SNIPER_AI_RETRIES=2
SNIPER_AI_RETRY_DELAY=5

# Tani filtr przed AI (oferty odrzucone nie kosztują nic, ale trafiają do evaluations.csv)
# Cena łączna (cena + wysyłka) w PLN, puste = bez limitu. 9000 = najwyższy próg zakupu z wytycznych (RTX 5090).
SNIPER_AI_PRICE_MIN=
SNIPER_AI_PRICE_MAX=9000
# Przynajmniej jedno słowo musi wystąpić (wielkość liter bez znaczenia); puste = bez filtra słów
SNIPER_AI_KEYWORDS=rtx,3050,3060,3070,3080,4050,4060,4070,4080,4090,5050,5060,5070,5080,5090
# Żadne z tych słów nie może wystąpić, np.: na części,uszkodzona płyta,icloud
SNIPER_AI_EXCLUDE_KEYWORDS=
# Gdzie szukać słów: title albo title+description
SNIPER_AI_KEYWORDS_IN=title+description
